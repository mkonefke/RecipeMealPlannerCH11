@{
    ViewData["Title"] = "Recipe & Meal PLanner";
}
<div class="p-5 mb-4 shadow" style="background-color:lightsteelblue;border-radius:30px;">
    <h1>Recipe Tracker & Meal Planner <i class="fa fa-book" style="font-size:24px"></i></h1>
    <p class="lead">
        Track recipes and plan future meals
    </p>
</div>

<div class="row justify-content-between">
    <div class="col-md-4">
        <h2>Add Recipes</h2>
        <p>Start adding recipes to your recipe tracker</p>

        <img src="~/images/cookbook.jpg"
             alt="cookbook"
             asp-append-version="true"
             class="img-fluid rounded recipe-img" />
    </div>

    <div class="col-md-4">
        <h2>Planning Meals</h2>
        <p>Begin a meal plan</p>

        <img src="~/images/plan.jpg"
             alt="planning"
             asp-append-version="true"
             class="img-fluid rounded recipe-img" />
    </div>
</div>
