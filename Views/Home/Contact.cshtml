@{
    ViewData["Title"] = "Contact Us";
}

<div class="p-5 mb-4 shadow"
     style="background-color: lightsteelblue; border-radius: 30px;">
    <h1>
        Contact Us
        <i class="fa fa-envelope" style="font-size: 24px"></i>
    </h1>
    <p class="lead">
        Have a question or suggestion? We would love to hear from you!
    </p>
</div>

<div class="container">
    <div class="row">
        <div class="col-md-6 mb-4">
            <h2>Get in Touch</h2>
            <p>
                If you have questions about using Recipe Tracker & Meal
                Planner feel free to contact us using the information below.
            </p>

            <h4><i class="fa fa-envelope"></i> Email</h4>
            <p>contact@recipetracker.example</p>

            <h4><i class="fa fa-phone"></i> Phone</h4>
            <p>(555) 555-1234</p>
            </p>
        </div>
    </div>
</div>